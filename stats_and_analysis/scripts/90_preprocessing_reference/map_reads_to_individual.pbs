#!/bin/bash
#PBS -P YOUR_PROJECT
#PBS -q normal
#PBS -l walltime=24:00:00
#PBS -l mem=64GB
#PBS -l ncpus=8
#PBS -l storage=scratch/YOUR_PROJECT+gdata/YOUR_PROJECT
#PBS -l wd

module load bowtie2/2.3.5.1
module load samtools/1.23.1

cd /path/to/metagenomics_project

if [ -z "$SAMPLE" ]; then
    echo "ERROR: SAMPLE variable is not set."
    exit 1
fi

R1="data/nohost_merged_samples/${SAMPLE}_nohost_merged_R1.fastq.gz"
R2="data/nohost_merged_samples/${SAMPLE}_nohost_merged_R2.fastq.gz"

INDEX="assemblies/individual/${SAMPLE}/bowtie2_index/${SAMPLE}_contigs"

OUTDIR="mapping/individual/${SAMPLE}"
mkdir -p "$OUTDIR"
mkdir -p logs/mapping

echo "Running Bowtie2 read mapping"
echo "SAMPLE: ${SAMPLE}"
echo "R1: ${R1}"
echo "R2: ${R2}"
echo "INDEX: ${INDEX}"
echo "OUTDIR: ${OUTDIR}"

if [ ! -s "$R1" ]; then
    echo "ERROR: R1 file not found or empty: ${R1}"
    exit 1
fi

if [ ! -s "$R2" ]; then
    echo "ERROR: R2 file not found or empty: ${R2}"
    exit 1
fi

if [ ! -s "${INDEX}.1.bt2" ]; then
    echo "ERROR: Bowtie2 index not found: ${INDEX}.1.bt2"
    exit 1
fi

bowtie2 \
  -x "$INDEX" \
  -1 "$R1" \
  -2 "$R2" \
  --very-sensitive \
  --threads 8 \
  2> "logs/mapping/${SAMPLE}_bowtie2_mapping.log" \
| samtools view -@ 4 -bS - \
| samtools sort -@ 4 -o "${OUTDIR}/${SAMPLE}_mapped_sorted.bam"

samtools index "${OUTDIR}/${SAMPLE}_mapped_sorted.bam"

samtools flagstat "${OUTDIR}/${SAMPLE}_mapped_sorted.bam" \
  > "${OUTDIR}/${SAMPLE}_flagstat.txt"

echo "Read mapping completed for ${SAMPLE}"
ls -lh "$OUTDIR"
