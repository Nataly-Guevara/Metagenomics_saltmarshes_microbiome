#!/bin/bash
#PBS -P YOUR_PROJECT
#PBS -q normalsr
#PBS -l walltime=24:00:00
#PBS -l mem=128GB
#PBS -l ncpus=16
#PBS -l jobfs=100GB
#PBS -l storage=scratch/YOUR_PROJECT+gdata/YOUR_PROJECT
#PBS -l wd

set -euo pipefail

module load apptainer

cd /path/to/metagenomics_project

SIF="containers/megahit_1.2.9.sif"

# Submit like:
# qsub -v SAMPLE=10_ACP_NAT_BS_22TNJ5LT3_ATACATCACA-TCTCCATTGA scripts/megahit_individual_Natural_BS.pbs

R1="data/nohost_merged_samples/${SAMPLE}_nohost_merged_R1.fastq.gz"
R2="data/nohost_merged_samples/${SAMPLE}_nohost_merged_R2.fastq.gz"

OUTDIR="assemblies/individual/${SAMPLE}"

echo "Running individual MEGAHIT assembly"
echo "SAMPLE: ${SAMPLE}"
echo "R1: ${R1}"
echo "R2: ${R2}"
echo "OUTDIR: ${OUTDIR}"

if [ ! -f "${R1}" ]; then
    echo "ERROR: R1 file not found: ${R1}"
    exit 1
fi

if [ ! -f "${R2}" ]; then
    echo "ERROR: R2 file not found: ${R2}"
    exit 1
fi

mkdir -p assemblies/individual
rm -rf "${OUTDIR}"

apptainer exec "${SIF}" megahit \
    -1 "${R1}" \
    -2 "${R2}" \
    -o "${OUTDIR}" \
    --min-contig-len 2000 \
    --memory 0.9 \
    --num-cpu-threads 16

echo "MEGAHIT completed for ${SAMPLE}"
ls -lh "${OUTDIR}/final.contigs.fa"
