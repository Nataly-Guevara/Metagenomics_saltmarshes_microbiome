#!/bin/bash
#PBS -P YOUR_PROJECT
#PBS -q normalsr
#PBS -l walltime=48:00:00
#PBS -l mem=256GB
#PBS -l ncpus=16
#PBS -l jobfs=100GB
#PBS -l storage=scratch/YOUR_PROJECT+gdata/YOUR_PROJECT
#PBS -l wd

module load apptainer

cd /path/to/metagenomics_project

SIF="containers/megahit_1.2.9.sif"

GROUP="Natural_BS"
OUTDIR="assemblies/coassemblies/${GROUP}"

mkdir -p assemblies/coassemblies

R1_FILES=$(ls data/nohost_merged_samples/*_NAT_BS_*_nohost_merged_R1.fastq.gz | paste -sd, -)
R2_FILES=$(ls data/nohost_merged_samples/*_NAT_BS_*_nohost_merged_R2.fastq.gz | paste -sd, -)

echo "Starting MEGAHIT co-assembly for ${GROUP}"
echo "R1 files:"
echo "$R1_FILES"
echo "R2 files:"
echo "$R2_FILES"

apptainer exec "$SIF" megahit \
  -1 "$R1_FILES" \
  -2 "$R2_FILES" \
  -o "$OUTDIR" \
  --presets meta-large \
  --min-contig-len 2000 \
  -t 16

echo "MEGAHIT co-assembly completed for ${GROUP}"

