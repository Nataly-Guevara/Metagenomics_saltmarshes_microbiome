#!/bin/bash
#PBS -P YOUR_PROJECT
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=08:00:00
#PBS -l storage=scratch/YOUR_PROJECT
#PBS -l wd
