#!/bin/bash
#PBS -P YOUR_PROJECT
#PBS -q normal
#PBS -l ncpus=32
#PBS -l mem=128GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/YOUR_PROJECT
#PBS -l jobfs=250GB
#PBS -l wd
#PBS -j oe
#PBS -N gtdbtk_MQ_dRep

module load python3/3.11.7
module load hmmer/3.4

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.local/bin/mash-Linux64-v2.3:$PATH"
export PATH="$HOME/.local/bin/pplacer-Linux-v1.1.alpha19:$PATH"

export GTDBTK_DATA_PATH=/path/to/local/databases/gtdbtk/release232

echo "Checking dependencies..."
which gtdbtk
which prodigal
which hmmalign
which hmmsearch
which pplacer
which guppy
which FastTree
which FastTreeMP
which skani
which mash

gtdbtk classify_wf \
  --genome_dir results/dRep_MQ_plus/dereplicated_genomes \
  --out_dir results/GTDBTk_MQ_plus_dRep \
  --extension fa \
  --cpus 32 \
  --pplacer_cpus 4 \
  --scratch_dir $PBS_JOBFS
