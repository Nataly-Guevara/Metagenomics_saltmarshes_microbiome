#!/bin/bash
#PBS -P YOUR_PROJECT
#PBS -q normal
#PBS -l walltime=12:00:00
#PBS -l mem=32GB
#PBS -l ncpus=8
#PBS -l storage=scratch/YOUR_PROJECT+gdata/YOUR_PROJECT
#PBS -l wd

module load bowtie2/2.3.5.1

cd /path/to/metagenomics_project

IN_DIR="data/nohuman_lanes"
OUT_DIR="data/nohost_lanes"
LOG_DIR="logs/salicornia_removal"
INDEX="references/host_salicornia_virginica/bowtie2_index/salicornia_virginica"

mkdir -p "$OUT_DIR" "$LOG_DIR"

for R1 in ${IN_DIR}/*_nohuman_R1.fastq.gz; do

    SAMPLE=$(basename "$R1" _nohuman_R1.fastq.gz)
    R2="${IN_DIR}/${SAMPLE}_nohuman_R2.fastq.gz"

    OUT_R1="${OUT_DIR}/${SAMPLE}_nohost_R1.fastq.gz"
    OUT_R2="${OUT_DIR}/${SAMPLE}_nohost_R2.fastq.gz"

    if [[ -s "$OUT_R1" && -s "$OUT_R2" ]]; then
        echo "Skipping completed: $SAMPLE"
        continue
    fi

    echo "Processing missing sample: $SAMPLE"

    bowtie2 \
      -x "$INDEX" \
      -1 "$R1" \
      -2 "$R2" \
      --very-sensitive \
      --threads 8 \
      --un-conc-gz "${OUT_DIR}/${SAMPLE}_nohost_R%.fastq.gz" \
      -S /dev/null \
      2> "${LOG_DIR}/${SAMPLE}_salicornia_removal.log"

done

echo "Resume Salicornia read removal completed."
