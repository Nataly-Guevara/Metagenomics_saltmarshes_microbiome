#!/bin/bash
#PBS -P YOUR_PROJECT
#PBS -q normal
#PBS -l walltime=12:00:00
#PBS -l mem=32GB
#PBS -l ncpus=8
#PBS -l storage=scratch/YOUR_PROJECT+gdata/YOUR_PROJECT
#PBS -l wd

module load bowtie2/2.3.5.1
module load samtools/1.23.1

cd /path/to/metagenomics_project

SAMPLE="10_ACP_NAT_BS_22TNJ5LT3_ATACATCACA-TCTCCATTGA"

R1="data/nohost_merged_samples/${SAMPLE}_nohost_merged_R1.fastq.gz"
R2="data/nohost_merged_samples/${SAMPLE}_nohost_merged_R2.fastq.gz"

INDEX="assemblies/megahit_pilot/${SAMPLE}/bowtie2_index/${SAMPLE}_contigs"

OUTDIR="mapping/megahit_pilot/${SAMPLE}"
mkdir -p "$OUTDIR"
mkdir -p logs/mapping

bowtie2 \
  -x "$INDEX" \
  -1 "$R1" \
  -2 "$R2" \
  --very-sensitive \
  --threads 8 \
  2> "logs/mapping/${SAMPLE}_bowtie2_mapping.log" \
| samtools view -@ 4 -bS - \
| samtools sort -@ 4 -o "${OUTDIR}/${SAMPLE}_mapped_sorted.bam"

samtools index "${OUTDIR}/${SAMPLE}_mapped_sorted.bam"

samtools flagstat "${OUTDIR}/${SAMPLE}_mapped_sorted.bam" \
  > "${OUTDIR}/${SAMPLE}_flagstat.txt"

echo "Read mapping completed for ${SAMPLE}"
