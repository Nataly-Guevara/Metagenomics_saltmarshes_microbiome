#!/bin/bash
#PBS -P YOUR_PROJECT
#PBS -q normal
#PBS -l ncpus=8
#PBS -l mem=16GB
#PBS -l walltime=02:00:00
#PBS -l jobfs=20GB
#PBS -l storage=scratch/YOUR_PROJECT+gdata/YOUR_PROJECT
#PBS -N kofam_test
#PBS -j oe

cd /path/to/metagenomics_project || exit 1

module load hmmer/3.4
module load parallel/20191022

mkdir -p results/functional_annotation/kofamscan/test

tools/kofam_scan/exec_annotation \
  -c tools/kofam_scan/config.yml \
  -f detail-tsv \
  -o results/functional_annotation/kofamscan/test/metabat2__10_ACP_NAT_BS_22TNJ5LT3_ATACATCACA-TCTCCATTGA__bin.11_kofam.tsv \
  --tmp-dir "$PBS_JOBFS/kofam_tmp" \
  results/functional_annotation/prodigal/proteins/metabat2__10_ACP_NAT_BS_22TNJ5LT3_ATACATCACA-TCTCCATTGA__bin.11.faa
