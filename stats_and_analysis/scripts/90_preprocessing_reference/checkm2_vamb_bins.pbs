#!/bin/bash
#PBS -P YOUR_PROJECT
#PBS -q normal
#PBS -l walltime=24:00:00
#PBS -l mem=128GB
#PBS -l ncpus=8
#PBS -l jobfs=10GB
#PBS -l storage=scratch/YOUR_PROJECT+gdata/YOUR_PROJECT
#PBS -l wd

set -euo pipefail

module load apptainer

cd /path/to/metagenomics_project

BIN_DIR="results/vamb_bins_all"
OUT_DIR="results/checkm2_vamb_bins"
DB="databases/checkm2/CheckM2_database/uniref100.KO.1.dmnd"

echo "Running CheckM2 on all VAMB bins"
echo "BIN_DIR: $BIN_DIR"
echo "OUT_DIR: $OUT_DIR"
echo "DB: $DB"
echo "Number of VAMB bins:"
find "$BIN_DIR" -maxdepth 1 -type l -name "*.fna" | wc -l

mkdir -p "$OUT_DIR"

apptainer exec containers/checkm2.sif checkm2 predict \
  --threads 8 \
  --input "$BIN_DIR" \
  --output-directory "$OUT_DIR" \
  --database_path "$DB" \
  -x fna

echo "CheckM2 completed for VAMB bins"
ls -lh "$OUT_DIR"
