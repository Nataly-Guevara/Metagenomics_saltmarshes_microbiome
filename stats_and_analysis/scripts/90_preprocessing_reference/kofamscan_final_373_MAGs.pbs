#!/bin/bash
#PBS -P YOUR_PROJECT
#PBS -q normal
#PBS -l ncpus=32
#PBS -l mem=32GB
#PBS -l walltime=12:00:00
#PBS -l jobfs=20GB
#PBS -l storage=scratch/YOUR_PROJECT+gdata/YOUR_PROJECT
#PBS -N kofam_373
#PBS -j oe

cd /path/to/metagenomics_project || exit 1

module load hmmer/3.4
module load parallel/20191022

mkdir -p results/functional_annotation/kofamscan

tools/kofam_scan/exec_annotation \
  -c tools/kofam_scan/config.yml \
  --cpu 32 \
  -f detail-tsv \
  -o results/functional_annotation/kofamscan/final_373_MAGs_kofam_detail.tsv \
  --tmp-dir "$PBS_JOBFS/kofam_tmp" \
  results/functional_annotation/final_373_MAGs_all_proteins.faa
